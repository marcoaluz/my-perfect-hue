# =============================================================================
# .env.example — Meu Tom Perfeito
# =============================================================================
# Copie este arquivo para `.env` e preencha com os valores reais.
# NÃO faça commit do .env (ele já está no .gitignore).
#
# No Lovable, este arquivo é gerado automaticamente pelo Lovable Cloud,
# então você só precisa preencher manualmente se rodar o projeto fora do
# Lovable (ex: clone local, deploy próprio).
# =============================================================================


# -----------------------------------------------------------------------------
# Lovable Cloud / Supabase — chaves PÚBLICAS (seguras no client)
# -----------------------------------------------------------------------------
# Onde obter: painel do Lovable Cloud → Settings → API
# (ou no dashboard do Supabase → Project Settings → API, se usar Supabase direto)

# URL do projeto Supabase
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_URL="https://SEU-PROJETO.supabase.co"

# ID do projeto (subdomínio do Supabase)
VITE_SUPABASE_PROJECT_ID="seu-project-id"

# Anon/Publishable key — pode ficar exposta no frontend.
# A segurança vem das policies de RLS no banco, NÃO de esconder esta chave.
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."


# -----------------------------------------------------------------------------
# ⚠️ Chaves SECRETAS — NUNCA coloque aqui nem em .env versionado
# -----------------------------------------------------------------------------
# Chaves como SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY (sk_live_...),
# ANTHROPIC_API_KEY (sk-ant-...), OPENAI_API_KEY etc. NÃO devem ficar em .env.
#
# No Lovable, use o "tool de secrets" (Cloud → Settings → Secrets).
# Elas ficam disponíveis automaticamente como process.env.NOME nas
# Edge Functions e código backend, sem nunca chegar ao bundle do frontend.
